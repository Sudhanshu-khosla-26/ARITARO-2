# =========================================================================
# CipherShield / Aritaro Cybersecurity Services - Environment Config Template
# =========================================================================

# --- Application Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database Config ---
# Local MongoDB connection URI
MONGODB_URI=mongodb://127.0.0.1:27017/ciphershield

# --- NextAuth Authentication Config ---
# Secret key used by NextAuth to sign/encrypt cookies and tokens.
# Generate a secure random string in production (e.g. using `openssl rand -base64 32`).
NEXTAUTH_SECRET=development-only-super-secret-key-32-chars-long-or-more
NEXTAUTH_URL=http://localhost:3000/api/auth

# --- Initial Seed Admin Account ---
ADMIN_EMAIL=admin@ciphershield.com
ADMIN_PASSWORD=Admin@123

# --- Security & Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# --- Mail / SMTP Server Configuration ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="CipherShield <noreply@ciphershield.com>"

# --- OAuth Providers (Optional / Commented out in code) ---
GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here
GITHUB_CLIENT_ID=github_client_id_here
GITHUB_CLIENT_SECRET=github_client_secret_here
